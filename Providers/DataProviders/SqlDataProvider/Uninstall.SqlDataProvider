IF EXISTS (
    SELECT 1
    FROM sys.objects
    WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}JacarandaCommentsPortalSettings]')
      AND type = N'U'
)
BEGIN
    DROP TABLE {databaseOwner}[{objectQualifier}JacarandaCommentsPortalSettings];
END
GO

